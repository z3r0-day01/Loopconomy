# ─────────────────────────────────────────────────────────────
# Debug Mode
# ─────────────────────────────────────────────────────────────
parser = argparse.ArgumentParser()
parser.add_argument('--debug', action='store_true', help='Enable debug mode')
args = parser.parse_args()

DEBUG = args.debug or os.environ.get('DEBUG', '').lower() == 'on'

def debug_print(msg):
    if DEBUG:
        print(f"[DEBUG] {msg}", file=sys.stderr, flush=True)

# ─────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────
API_BASE = "http://localhost:8080"
CREDENTIALS_FILE = os.path.expanduser("~/.loop_credentials")
HISTORY_FILE = os.path.expanduser("~/.loop_history")
RC_FILE = os.path.expanduser("~/.looprc")
MAIN_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..')

# Load configuration from ~/.looprc
config = ConfigParser()
if os.path.exists(RC_FILE):
    config.read(RC_FILE)
    API_BASE = config.get('main', 'api_url', fallback=API_BASE)
    LOG_LINES_DEFAULT = config.getint('main', 'log_lines', fallback=50)
    THEME = config.get('display', 'theme', fallback='dark')
else:
    LOG_LINES_DEFAULT = 50
    THEME = 'dark'

# ─────────────────────────────────────────────────────────────
# Command Aliases
# ─────────────────────────────────────────────────────────────
ALIASES = {
    'ls': 'logs',
    'r': 'restart',
    'st': 'status',
    'q': 'quit',
}

# ─────────────────────────────────────────────────────────────
# Colors (Fish-like theme with theme support)
# ─────────────────────────────────────────────────────────────
class C:
    MAGENTA = '\033[0;35m'
    HEADER = '\033[1;35m'
    GREEN = '\033[0;32m'
    LGREEN = '\033[92m'
    CYAN = '\033[0;36m'
    LCYAN = '\033[96m'
    RED = '\033[0;31m'
    YELLOW = '\033[1;33m'
    WHITE = '\033[1;37m'
    DIM = '\033[2m'
    NC = '\033[0m'
    BOLD = '\033[1m'

# ─────────────────────────────────────────────────────────────
# ANSI Screen Control
# ─────────────────────────────────────────────────────────────
CLEAR = '\033[2J\033[H'
HIDE_CURSOR = '\033[?25l'
SHOW_CURSOR = '\033[?25h'
MOVE = lambda l, c: f'\033[{l};{c}H'
SAVE = '\033[s'
RESTORE = '\033[u'

# ─────────────────────────────────────────────────────────────
# Systemd Control
# ─────────────────────────────────────────────────────────────
SERVICE = "loopconomy"

def systemctl(action: str) -> tuple:
    if action in ('start', 'stop', 'restart', 'reload'):
        if action == 'stop':
            result = subprocess.run(['pkill', '-f', 'node main.js'], capture_output=True, text=True, timeout=10)
            return result.returncode == 0, "Stopped", ""
        elif action == 'restart':
            subprocess.run(['pkill', '-f', 'node main.js'], capture_output=True, timeout=10)
            time.sleep(1)
            subprocess.Popen(['node', 'main.js'], cwd=MAIN_DIR, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True, "Restarting...", ""
        elif action == 'start':
            subprocess.Popen(['node', 'main.js'], cwd=MAIN_DIR, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True, "Starting...", ""
    
    try:
        result = subprocess.run(
            ['systemctl', action, SERVICE],
            capture_output=True, text=True, timeout=30
        )
        return result.returncode == 0, result.stdout, result.stderr
    except Exception as e:
        return False, '', str(e)

def systemctl_status() -> str:
    try:
        result = subprocess.run(
            ['systemctl', 'status', SERVICE, '--no-pager'],
            capture_output=True, text=True, timeout=10
        )
        return result.stdout + result.stderr
    except Exception as e:
        return f"Error: {e}"

def journalctl_tail(lines: int = 50, filter_level: str = None, grep_pattern: str = None) -> str:
    try:
        cmd = ['journalctl', '-u', SERVICE, '--no-pager', '-n', str(lines)]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        output = result.stdout
        
        if filter_level:
            output = filter_logs_by_level(output, filter_level)
        
        if grep_pattern:
            output = filter_logs_by_pattern(output, grep_pattern)
        
        return output
    except Exception as e:
        return f"Error: {e}"

def filter_logs_by_level(logs: str, level: str) -> str:
    level_keywords = {
        'error': ['error', 'err', 'fatal', 'exception', 'failed', 'critical'],
        'warn': ['warn', 'warning'],
        'info': ['info', 'notice'],
    }
    
    keywords = level_keywords.get(level.lower(), [])
    if not keywords:
        return logs
    
    lines = logs.split('\n')
    filtered = []
    for line in lines:
        line_lower = line.lower()
        if any(kw in line_lower for kw in keywords):
            filtered.append(line)
    
    return '\n'.join(filtered)

def filter_logs_by_pattern(logs: str, pattern: str) -> str:
    try:
        regex = re.compile(pattern, re.IGNORECASE)
        lines = logs.split('\n')
        filtered = [line for line in lines if regex.search(line)]
        return '\n'.join(filtered)
    except re.error:
        return logs

# ─────────────────────────────────────────────────────────────
# Real-time Clock
# ─────────────────────────────────────────────────────────────
current_time = "00:00"
time_running = True

def clock_update():
    global current_time
    while time_running:
        current_time = datetime.now().strftime("%H:%M")
        time.sleep(1)

# ─────────────────────────────────────────────────────────────
# Connection Status
# ─────────────────────────────────────────────────────────────
connection_status = {"connected": False, "last_check": None}

def check_connection(api_base: str) -> bool:
    import requests
    try:
        r = requests.get(f"{api_base}/api/status", timeout=2)
        connection_status["connected"] = r.status_code == 200
    except:
        connection_status["connected"] = False
    connection_status["last_check"] = time.time()
    return connection_status["connected"]

# ─────────────────────────────────────────────────────────────
# API Client
# ─────────────────────────────────────────────────────────────
class APIClient:
    def __init__(self):
        self.base_url = API_BASE
        self.username = None
        self.password = None
        
    def load_credentials(self) -> bool:
        if os.path.exists(CREDENTIALS_FILE):
            try:
                with open(CREDENTIALS_FILE, 'r') as f:
                    for line in f:
                        if line.startswith('username:'):
                            self.username = line.split(':', 1)[1].strip()
                        elif line.startswith('password:'):
                            self.password = line.split(':', 1)[1].strip()
            except:
                pass
        return bool(self.username and self.password)
    
    def save_credentials(self, username: str, password: str):
        try:
            with open(CREDENTIALS_FILE, 'w') as f:
                f.write(f"username:{username}\npassword:{password}\n")
            os.chmod(CREDENTIALS_FILE, 0o600)
            self.username = username
            self.password = password
        except:
            pass
    
    def clear_credentials(self):
        if os.path.exists(CREDENTIALS_FILE):
            os.remove(CREDENTIALS_FILE)
        self.username = None
        self.password = None
    
    def request(self, method: str, endpoint: str, data: dict = None) -> dict:
        import requests
        url = f"{self.base_url}{endpoint}"
        auth = None
        if self.username and self.password:
            auth = (self.username, self.password)
        try:
            if method == 'GET':
                r = requests.get(url, auth=auth, timeout=3)
            else:
                r = requests.post(url, json=data, auth=auth, timeout=5)
            
            if r.status_code >= 400:
                error_data = r.json() if r.headers.get('content-type', '').startswith('application/json') else {}
                return {'error': error_data.get('error', f'HTTP {r.status_code}: {r.text}')}
            
            return r.json()
        except requests.exceptions.ConnectionError:
            return {'error': f'Cannot connect to {self.base_url}. Is the server running?'}
        except requests.exceptions.Timeout:
            return {'error': 'Request timed out'}
        except Exception as e:
            return {'error': str(e)}
    
    def get_status(self) -> dict:
        import requests
        try:
            r = requests.get(f"{self.base_url}/api/status", timeout=2)
            status = r.json()
            connection_status["connected"] = True
            return status
        except:
            connection_status["connected"] = False
            return {'servers': 0, 'users': 0, 'uptime': 'offline', 'ping': 0, 'ram': 0}
    
    def login(self, username: str, password: str) -> dict:
        import requests
        try:
            r = requests.post(f"{self.base_url}/api/login", json={'username': username, 'password': password}, timeout=5)
            return r.json()
        except Exception as e:
            return {'error': str(e)}
    
    def change_password(self, current_password: str, new_password: str) -> dict:
        return self.request('POST', '/api/change-password', {
            'username': self.username,
            'currentPassword': current_password,
            'newPassword': new_password
        })
    
    def shell(self, command: str, data: dict = None) -> dict:
        return self.request('POST', f'/api/shell/{command}', data or {})
    
    def get_servers(self) -> list:
        result = self.shell('servers')
        return result.get('servers', [])

# ─────────────────────────────────────────────────────────────
# Command Handler
# ─────────────────────────────────────────────────────────────
class CommandHandler:
    def __init__(self, tui):
        self.tui = tui
        self.api = tui.api
        self.history: List[str] = []
        self.history_pos = -1
        self.history_limit = 50
        self.settings = {
            'history_limit': 50,
            'api_url': API_BASE,
            'log_lines': LOG_LINES_DEFAULT,
            'theme': THEME,
        }
        self._load_history()
    
    def _load_history(self):
        if os.path.exists(HISTORY_FILE):
            try:
                with open(HISTORY_FILE, 'r') as f:
                    self.history = [l.strip() for l in f if l.strip()][-50:]
            except:
                pass
        self.history_pos = len(self.history)
    
    def _save_history(self):
        try:
            with open(HISTORY_FILE, 'w') as f:
                for cmd in self.history[-self.history_limit:]:
                    f.write(f"{cmd}\n")
        except:
            pass
    
    def add_history(self, cmd: str):
        if cmd and cmd not in ('', 'help', 'clear', 'exit', 'logout', 'history'):
            if cmd not in self.history:
                self.history.append(cmd)
                if len(self.history) > self.settings['history_limit']:
                    self.history.pop(0)
        self.history_pos = len(self.history)
        self._save_history()
    
    def history_up(self) -> str:
        if self.history and self.history_pos > 0:
            self.history_pos -= 1
            return self.history[self.history_pos]
        return ""
    
    def history_down(self) -> str:
        if self.history_pos < len(self.history) - 1:
            self.history_pos += 1
            return self.history[self.history_pos]
        self.history_pos = len(self.history)
        return ""
    
    def resolve_alias(self, cmd: str) -> str:
        return ALIASES.get(cmd.lower(), cmd)
    
    def get_completions(self, text: str) -> List[str]:
        main_commands = [
            'start', 'stop', 'restart', 'status', 'logs',
            'say', 'broadcast', 'add', 'remove', 'balance',
            'mute', 'unmute', 'clear', 'help', 'exit', 'logout',
            'interface', 'settings', 'history', 'clear-history'
        ]
        main_commands.extend(list(ALIASES.keys()))
        
        if self.tui.mode == "server":
            main_commands.extend([
                '/blackjack', '/poker', '/roulette', '/slots', '/keno',
                '/balance', '/add', '/remove', '/mute', '/unmute',
                '/say', '/clear', '/exit', '/help', '/back'
            ])
        
        if text:
            return [c for c in main_commands if c.startswith(text.lower())]
        return main_commands
    
    def handle(self, cmd_line: str) -> List[str]:
        cmd_line = cmd_line.strip()
        if not cmd_line:
            return []
        
        self.add_history(cmd_line)
        
        parts = cmd_line.split(maxsplit=1)
        cmd = self.resolve_alias(parts[0].lower())
        args = parts[1] if len(parts) > 1 else ""
        
        if cmd in ('exit', 'quit', 'q'):
            return ['[dim]Goodbye![/dim]']
        
        if cmd == 'help':
            return self.cmd_help()
        if cmd == 'clear':
            return ['__CLEAR__']
        
        if cmd == 'history':
            return self.cmd_history()
        if cmd == 'clear-history':
            self.history = []
            return ['[dim]History cleared[/dim]']
        
        if cmd == 'settings':
            return self.cmd_settings(args)
        
        if self.tui.mode == "main":
            return self.handle_main(cmd, args)
        else:
            return self.handle_server(cmd, args)
    
    def handle_main(self, cmd: str, args: str) -> List[str]:
        output = []
        
        if cmd == 'start':
            ok, out, err = systemctl('start')
            return [f"{C.GREEN}Started loopconomy{C.NC}" if ok else f"{C.RED}Failed: {err or out}{C.NC}"]
        
        if cmd == 'stop':
            ok, out, err = systemctl('stop')
            return [f"{C.YELLOW}Stopped loopconomy{C.NC}" if ok else f"{C.RED}Failed: {err or out}{C.NC}"]
        
        if cmd == 'restart':
            ok, out, err = systemctl('restart')
            return [f"{C.YELLOW}Restarting loopconomy...{C.NC}" if ok else f"{C.RED}Failed: {err or out}{C.NC}"]
        
        if cmd == 'status':
            return self.cmd_status()
        
        if cmd == 'logs':
            return self.cmd_logs(args)
        
        if cmd == 'interface':
            return self.cmd_interface(args)
        
        if cmd == 'say' and args:
            parts = args.split(maxsplit=1)
            if len(parts) >= 2:
                ch = parts[0].replace('#', '')
                msg = parts[1]
                r = self.api.shell('say', {'channel': ch, 'message': msg})
                if r.get('success'):
                    return [f"{C.GREEN}Sent to #{ch}: {msg}{C.NC}"]
                error_msg = r.get('error', 'Failed')
                return [f"{C.RED}Error: {error_msg}{C.NC}"]
            return [f"{C.RED}Usage: say #channel message{C.NC}"]
        
        if cmd == 'broadcast' and args:
            r = self.api.shell('broadcast', {'message': args})
            if r.get('success'):
                return [f"{C.GREEN}Broadcasted to all servers{C.NC}"]
            error_msg = r.get('error', 'Failed')
            return [f"{C.RED}Error: {error_msg}{C.NC}"]
        
        if cmd in ('add', 'give') and args:
            parts = args.split()
            if len(parts) >= 2:
                try:
                    amt = int(parts[0])
                    user = parts[1]
                    r = self.api.shell('addcoins', {'user': user, 'amount': amt})
                    if r.get('success'):
                        return [f"{C.GREEN}Added {amt} coins to {user}{C.NC}"]
                    error_msg = r.get('error', 'Failed')
                    return [f"{C.RED}Error: {error_msg}{C.NC}"]
                except ValueError:
                    return [f"{C.RED}Usage: add <amount> <user>{C.NC}"]
            return [f"{C.RED}Usage: add <amount> <user>{C.NC}"]
        
        if cmd in ('balance', 'bal') and args:
            r = self.api.shell('balance', {'user': args})
            if 'error' in r:
                return [f"{C.RED}Error: {r.get('error')}{C.NC}"]
            coins = r.get('coins', 0)
            return [f"{C.CYAN}{args}{C.NC} balance: {C.GREEN}{coins}{C.NC}"]
        
        if cmd == 'mute' and args:
            parts = args.split(maxsplit=2)
            if len(parts) >= 2:
                user, time_val = parts[0], parts[1]
                reason = parts[2] if len(parts) > 2 else "Muted via shell"
                r = self.api.shell('mute', {'user': user, 'time': time_val, 'reason': reason})
                if r.get('success'):
                    return [f"{C.GREEN}Muted {user} for {time_val}{C.NC}"]
                error_msg = r.get('error', 'Failed')
                return [f"{C.RED}Error: {error_msg}{C.NC}"]
            return [f"{C.RED}Usage: mute <user> <time> [reason]{C.NC}"]
        
        if cmd == 'unmute' and args:
            r = self.api.shell('unmute', {'user': args})
            if r.get('success'):
                return [f"{C.GREEN}Unmuted {args}{C.NC}"]
            error_msg = r.get('error', 'Failed')
            return [f"{C.RED}Error: {error_msg}{C.NC}"]
        
        if cmd == 'logout':
            self.api.clear_credentials()
            return [f"{C.CYAN}Logged out{C.NC}"]
        
        return [f"{C.RED}Unknown command: {cmd} (type 'help'){C.NC}"]
    
    def handle_server(self, cmd: str, args: str) -> List[str]:
        if cmd.startswith('/'):
            cmd = cmd[1:]
        
        if cmd in ('exit', 'back', 'quit'):
            self.tui.set_mode("main")
            self.tui.set_server("", "")
            return [f"{C.CYAN}Returned to main interface{C.NC}"]
        
        if cmd == 'clear':
            return ['__CLEAR__']
        
        if cmd == 'help':
            return self.cmd_server_help()
        
        if cmd == 'say' and args:
            r = self.api.shell('say', {'channel': self.tui.server_id, 'message': args})
            if r.get('success'):
                return [f"{C.GREEN}Sent: {args}{C.NC}"]
            error_msg = r.get('error', 'Failed')
            return [f"{C.RED}Error: {error_msg}{C.NC}"]
        
        if cmd in ('balance', 'bal'):
            target = args or self.api.username or 'me'
            r = self.api.shell('balance', {'user': target})
            if 'error' in r:
                return [f"{C.RED}Error: {r.get('error')}{C.NC}"]
            return [f"{C.CYAN}{target}{C.NC}: {C.GREEN}{r.get('coins', 0)}{C.NC}"]
        
        if cmd in ('add', 'give', 'remove') and args:
            parts = args.split(maxsplit=1)
            if parts:
                amt = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 100
                r = self.api.shell('addcoins' if cmd != 'remove' else 'removecoins', 
                    {'user': parts[0], 'amount': amt})
                if r.get('success'):
                    return [f"{C.GREEN}Done{C.NC}"]
                error_msg = r.get('error', 'Failed')
                return [f"{C.RED}Error: {error_msg}{C.NC}"]
        
        game_commands = ['blackjack', 'poker', 'roulette', 'slots', 'keno', 'bingo', 'russianroulette', 'wheel', 'coinflip']
        if cmd in game_commands:
            bet = int(args) if args.isdigit() else 100
            r = self.api.shell('game-play', {
                'game_type': cmd,
                'bet_amount': bet,
                'server_id': self.tui.server_id
            })
            if r.get('won') is not None:
                details = r.get('details', '')
                if details:
                    return [f"{C.CYAN}Rolled{C.NC}: {details}"]
                return [f"{C.GREEN}WIN! +{r.get('payout', 0)}{C.NC}" if r.get('won') else f"{C.RED}Lose{C.NC}"]
            if 'error' in r:
                return [f"{C.RED}Error: {r.get('error')}{C.NC}"]
            return [f"{C.CYAN}{r}{C.NC}"]
        
        return [f"{C.RED}Unknown in server mode: {cmd}{C.NC}"]
    
    def cmd_logs(self, args: str) -> List[str]:
        lines = self.settings.get('log_lines', LOG_LINES_DEFAULT)
        filter_level = None
        grep_pattern = None
        
        if args:
            args_parts = args.split()
            i = 0
            while i < len(args_parts):
                arg = args_parts[i]
                if arg.startswith('--'):
                    if arg == '--grep':
                        if i + 1 < len(args_parts):
                            grep_pattern = args_parts[i + 1]
                            i += 2
                            continue
                    elif arg in ('error', 'warn', 'info'):
                        filter_level = arg
                        i += 1
                        continue
                
                try:
                    lines = int(arg)
                except ValueError:
                    pass
                i += 1
        
        logs = journalctl_tail(lines, filter_level, grep_pattern)
        
        header = f"{C.CYAN}═══ Last {lines} log lines"
        if filter_level:
            header += f" ({filter_level.upper()})"
        if grep_pattern:
            header += f" (grep: {grep_pattern})"
        header += " ═══"
        
        return [header + C.NC] + logs.split('\n')[-lines:]
    
    def cmd_help(self) -> List[str]:
        alias_list = ", ".join([f"{k}->{v}" for k, v in ALIASES.items()])
        return [
            f"{C.HEADER}LUMA - Loopconomy Unified Manager Application{C.NC}",
            f"{C.DIM}Version 1.0.0{C.NC}",
            "",
            f"{C.HEADER}═══ Available Commands ═══{C.NC}",
            "",
            f"{C.GREEN}Bot Control (systemd):{C.NC}",
            f"  {C.GREEN}start{C.NC}, {C.GREEN}stop{C.NC}, {C.GREEN}restart{C.NC} - systemctl control",
            f"  {C.GREEN}status{st if st else ''}{C.NC} - Full status (alias: st)",
            f"  {C.GREEN}logs{ls if ls else ''}{C.NC} [n] - View logs (alias: ls)",
            "",
            f"{C.CYAN}Bot Control (API):{C.NC}",
            f"  {C.CYAN}say{C.NC} #ch msg - Send message",
            f"  {C.CYAN}broadcast{C.NC} msg - Broadcast",
            f"  {C.CYAN}add{C.NC} amt user - Add coins",
            f"  {C.CYAN}balance{C.NC} [user] - Check balance",
            f"  {C.CYAN}mute{C.NC} user time [r] - Mute",
            f"  {C.CYAN}unmute{C.NC} user - Unmute",
            "",
            f"{C.YELLOW}Interface:{C.NC}",
            f"  {C.YELLOW}interface{C.NC} [server] - Switch to server mode",
            f"  {C.YELLOW}settings{C.NC} [key val] - View/set settings",
            "",
            f"{C.MAGENTA}Log Filtering:{C.NC}",
            f"  {C.MAGENTA}logs error{C.NC} - Show only errors",
            f"  {C.MAGENTA}logs warn{C.NC} - Show only warnings",
            f"  {C.MAGENTA}logs info{C.NC} - Show only info",
            f"  {C.MAGENTA}logs --grep <pattern>{C.NC} - Search logs",
            "",
            f"{C.BOLD}Command Aliases:{C.NC}",
            f"  {alias_list}",
            "",
            f"{C.DIM}System:{C.DIM}",
            f"  {C.DIM}clear{C.NC} - Clear screen",
            f"  {C.DIM}history{C.NC} - Show history",
            f"  {C.DIM}clear-history{C.NC} - Clear history",
            f"  {C.DIM}exit{C.NC}, {C.DIM}q{C.NC}, {C.DIM}quit{C.NC} - Exit"
        ]
    
    def cmd_server_help(self) -> List[str]:
        return [
            f"{C.HEADER}═══ Server Mode Help ═══{C.NC}",
            "",
            f"{C.GREEN}Games:{C.NC}",
            f"  {C.GREEN}/blackjack{C.NC} [bet] - Play blackjack",
            f"  {C.GREEN}/poker{C.NC} [bet] - Play poker",
            f"  {C.GREEN}/roulette{C.NC} [bet] - Play roulette",
            f"  {C.GREEN}/slots{C.NC} [bet] - Play slots",
            f"  {C.GREEN}/keno{C.NC} [bet] - Play keno",
            "",
            f"{C.CYAN}Commands:{C.NC}",
            f"  {C.CYAN}/balance{C.NC} [user] - Check balance",
            f"  {C.CYAN}/add{C.NC} user amt - Add coins",
            f"  {C.CYAN}/say{C.NC} msg - Send message",
            "",
            f"{C.DIM}Navigation:{C.DIM}",
            f"  {C.DIM}exit, back{C.NC} - Return to main"
        ]
    
    def cmd_status(self) -> List[str]:
        st = self.api.get_status()
        svc = systemctl_status()
        svc_short = '\n'.join(svc.split('\n')[:10])
        
        conn_status = C.GREEN + "Connected" + C.NC if connection_status.get("connected", False) else C.RED + "Disconnected" + C.NC
        
        return [
            f"{C.HEADER}═══ Bot Status ═══{C.NC}",
            f"Systemd: {'[green]Running[/green]' if systemctl('is-active')[0] else '[red]Stopped[/red]'}",
            f"API: {conn_status}",
            f"Servers: {st.get('servers', 0)} | Users: {st.get('users', 0)}",
            f"Uptime: {st.get('uptime', 'N/A')} | Ping: {st.get('ping', 0)}ms",
            "",
            f"{C.DIM}{svc_short}{C.NC}"
        ]
    
    def cmd_interface(self, args: str) -> List[str]:
        if not args:
            servers = self.api.get_servers()
            if not servers:
                return [f"{C.CYAN}No servers found{C.NC}"]
            list_str = '\n'.join([f"  - {s['name']} ({s['id']})" for s in servers])
            return [f"{C.CYAN}Available servers:{C.NC}", list_str, f"{C.DIM}Use: interface <name_or_id>{C.DIM}"]
        
        servers = self.api.get_servers()
        target = args.lower()
        
        for s in servers:
            if s['name'].lower() == target or s['id'].lower() == target:
                self.tui.set_mode("server")
                self.tui.set_server(s['name'], s['id'])
                return [f"{C.GREEN}Switched to {s['name']}{C.NC}"]
        
        return [f"{C.RED}Server not found: {args}{C.NC}"]
    
    def cmd_settings(self, args: str) -> List[str]:
        if not args:
            settings_str = '\n'.join([f"  {k}: {v}" for k, v in self.settings.items()])
            return [f"{C.CYAN}Current settings:{C.NC}", settings_str]
        
        parts = args.split(maxsplit=1)
        key = parts[0].lower()
        val = parts[1] if len(parts) > 1 else None
        
        if key == 'history':
            if val:
                if val.lower() == 'clear':
                    self.history = []
                    return [f"{C.CYAN}History cleared{C.NC}"]
                try:
                    limit = int(val)
                    self.settings['history_limit'] = limit
                    return [f"{C.CYAN}History limit set to {limit}{C.NC}"]
                except ValueError:
                    return [f"{C.RED}Invalid number{C.NC}"]
            return [f"{C.CYAN}History limit: {self.settings['history_limit']}{C.NC}"]
        
        if key == 'api_url':
            if val:
                self.settings['api_url'] = val
                self.api.base_url = val
                return [f"{C.CYAN}API URL set to {val}{C.NC}"]
            return [f"{C.CYAN}API URL: {self.settings['api_url']}{C.NC}"]
        
        if key == 'log_lines':
            if val:
                try:
                    lines = int(val)
                    self.settings['log_lines'] = lines
                    return [f"{C.CYAN}Log lines set to {lines}{C.NC}"]
                except ValueError:
                    return [f"{C.RED}Invalid number{C.NC}"]
            return [f"{C.CYAN}Log lines: {self.settings['log_lines']}{C.NC}"]
        
        return [f"{C.RED}Unknown setting: {key}{C.NC}"]
    
    def cmd_history(self) -> List[str]:
        if not self.history:
            return [f"{C.DIM}No history{C.NC}"]
        return [f"{C.CYAN}Command History:{C.NC}"] + [f"  {i+1}. {h}" for i, h in enumerate(self.history)]

# ─────────────────────────────────────────────────────────────
# TUI Application
# ─────────────────────────────────────────────────────────────
class LoopTUI:
    def __init__(self):
        self.api = APIClient()
        self.mode = "main"
        self.server = ""
        self.server_id = ""
        self.handler = CommandHandler(self)
        
        self.term_rows = 24
        self.term_cols = 80
        self.output_lines: List[str] = []
        self.scroll_offset = 0
        
        try:
            import shutil
            self.term_rows, self.term_cols = shutil.get_terminal_size()
        except:
            pass
        
        if not self.api.load_credentials():
            self.do_login()
    
    def set_mode(self, mode: str):
        self.mode = mode
    
    def set_server(self, name: str, server_id: str = ""):
        self.server = name
        self.server_id = server_id
    
    def do_login(self):
        print(f"\n{C.YELLOW}═══ Login Required ═══{C.NC}\n")
        u = input(f"{C.CYAN}Username: {C.NC}").strip()
        p = input(f"{C.CYAN}Password: {C.NC}").strip()
        
        r = self.api.login(u, p)
        if r.get('token'):
            self.api.save_credentials(u, p)
            if r.get('mustChangePassword'):
                print(f"\n{C.RED}╔════════════════════════════════════════════════════════════════╗{C.NC}")
                print(f"{C.RED}║  MUST CHANGE PASSWORD!                                    ║{C.NC}")
                print(f"{C.RED}╚════════════════════════════════════════════════════════════════╝{C.NC}\n")
                while True:
                    np = input(f"{C.CYAN}New Password: {C.NC}").strip()
                    cp = input(f"{C.CYAN}Repeat: {C.NC}").strip()
                    if np != cp:
                        print(f"{C.RED}Passwords don't match!{C.NC}")
                        continue
                    rr = self.api.change_password(p, np)
                    if rr.get('success'):
                        self.api.save_credentials(u, np)
                        print(f"{C.GREEN}Password changed!{C.NC}")
                        break
        else:
            error_msg = r.get('error', 'Invalid credentials')
            print(f"{C.RED}Login failed: {error_msg}{C.NC}")
            sys.exit(1)
    
    def draw_screen(self, input_buffer: str = ""):
        try:
            import shutil
            rows, cols = shutil.get_terminal_size()
            self.term_rows = rows
            self.term_cols = cols
        except:
            pass
        
        try:
            st = self.api.get_status()
            running = st.get('servers', 0) > 0
        except:
            st = {'servers': 0, 'users': 0, 'uptime': 'unknown', 'ping': 0}
            running = False
        
        running_str = f"{C.GREEN}RUNNING{C.NC}" if running else f"{C.RED}STOPPED{C.NC}"
        conn_indicator = f"{C.GREEN}●{C.NC}" if connection_status.get("connected", False) else f"{C.RED}●{C.NC}"
        mode_str = f"interface {self.server}" if self.server else "main"
        
        header = [
            f"{C.MAGENTA}╔{'═' * (self.term_cols - 2)}╗{C.NC}",
            f"{C.MAGENTA}║{C.NC}  {C.HEADER}LUMA({current_time}):{C.NC} {mode_str}  {conn_indicator} {running_str}  Srv: {st.get('servers', 0) if running else 0}{' ' * max(0, self.term_cols - 60)}{C.MAGENTA}║{C.NC}",
            f"{C.MAGENTA}╚{'═' * (self.term_cols - 2)}╝{C.NC}",
            ""
        ]
        
        header_lines = 4
        footer_lines = 1
        input_lines = 2
        visible_height = self.term_rows - header_lines - footer_lines - input_lines
        
        visible_output = self.output_lines[-visible_height:] if len(self.output_lines) > visible_height else self.output_lines
        
        prompt = f"{C.MAGENTA}{self.api.username or 'admin'}@{self.server}{C.NC}> " if self.mode == "server" else f"{C.LGREEN}>{C.NC} "
        
        print(CLEAR, end='')
        
        for line in header:
            print(line)
        
        for line in visible_output:
            print(line[:self.term_cols - 2])
        
        remaining = visible_height - len(visible_output)
        for _ in range(max(0, remaining)):
            print(' ' * (self.term_cols - 2))
        
        print(f"{'─' * (self.term_cols - 2)}")
        print(f"{prompt}{C.WHITE}{input_buffer}{C.NC}", end='', flush=True)
        
        print(MOVE(self.term_rows, 1) + f"{C.DIM}[Tab]=complete [↑↓]=history [Enter]=run [Ctrl+C]=exit{C.NC}", end='', flush=True)
        
        input_row = header_lines + len(visible_output) + 1
        print(MOVE(input_row, len(prompt) + len(input_buffer) + 1), end='', flush=True)
    
    def add_output(self, lines: List[str]):
        for line in lines:
            if line == '__CLEAR__':
                self.output_lines = []
                continue
            parsed = self.parse_markup(line)
            self.output_lines.append(parsed)
        
        max_lines = 1000
        if len(self.output_lines) > max_lines:
            self.output_lines = self.output_lines[-max_lines:]
    
    def parse_markup(self, text: str) -> str:
        import re
        
        def replace_match(match):
            tag = match.group(1).lower()
            content = match.group(2)
            colors = {
                'green': C.GREEN, 'success': C.GREEN,
                'red': C.RED, 'error': C.RED,
                'cyan': C.CYAN, 'info': C.CYAN,
                'yellow': C.YELLOW, 'warning': C.YELLOW,
                'dim': C.DIM,
                'header': C.HEADER,
                'magenta': C.MAGENTA,
                'white': C.WHITE,
            }
            return f"{colors.get(tag, '')}{content}{C.NC}"
        
        return re.sub(r'\[(\w+)\](.*?)\[/\1\]', replace_match, text)
    
    def get_input(self) -> tuple:
        try:
            fd = sys.stdin.fileno()
            old_settings = termios.tcgetattr(fd)
            tty.setraw(fd)
            old_flags = fcntl.fcntl(fd, fcntl.F_GETFL)
            fcntl.fcntl(fd, fcntl.F_SETFL, old_flags | os.O_NONBLOCK)
            
            buf = ""
            try:
                start = time.time()
                while time.time() - start < 0.1:
                    try:
                        ch = sys.stdin.read(1)
                        if ch:
                            if ch == '\n' or ch == '\r':
                                print('', flush=True)
                                return buf, 'enter'
                            elif ch == '\t':
                                return buf, 'tab'
                            elif ch == '\x7f':
                                return buf[:-1], 'backspace'
                            elif ch == '\x1b':
                                seq = ''
                                try:
                                    seq = sys.stdin.read(2)
                                except:
                                    pass
                                if seq == '[A':
                                    return buf, 'up'
                                elif seq == '[B':
                                    return buf, 'down'
                                elif seq == '[C':
                                    return buf, 'right'
                                elif seq == '[D':
                                    return buf, 'left'
                                return buf, 'escape'
                            elif ch >= ' ':
                                buf += ch
                            elif ch == '\x03':
                                raise KeyboardInterrupt
                    except:
                        pass
                    time.sleep(0.01)
                return buf, 'timeout'
            finally:
                fcntl.fcntl(fd, fcntl.F_SETFL, old_flags)
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        except KeyboardInterrupt:
            raise
        except Exception as e:
            debug_print(f"Input error: {e}")
            try:
                return input("> "), 'enter'
            except:
                return '', 'eof'
    
    def run(self):
        global time_running
        
        t = threading.Thread(target=clock_update, daemon=True)
        t.start()
        
        conn_thread = threading.Thread(target=check_connection, args=(API_BASE,), daemon=True)
        conn_thread.start()
        
        print(HIDE_CURSOR, end='', flush=True)
        try:
            self.add_output([
                f"{C.GREEN}LUMA v1.0.0 loaded.{C.NC}",
                f"{C.DIM}Type 'help' for commands and aliases.{C.NC}",
                ""
            ])
            self.draw_screen("")
            
            input_buffer = ""
            last_time = current_time
            last_draw = 0
            
            while True:
                if current_time != last_time:
                    self.draw_screen(input_buffer)
                    last_time = current_time
                    last_draw = time.time()
                
                buf, key_type = self.get_input()
                
                if key_type == 'enter':
                    self.draw_screen("")
                    if buf.strip():
                        prompt = f"{C.MAGENTA}LUMA({current_time}):{C.NC} " if self.mode == "main" else f"{C.MAGENTA}{self.api.username}@{self.server}>{C.NC} "
                        self.add_output([f"{prompt}{buf}"])
                        
                        try:
                            result = self.handler.handle(buf)
                            self.add_output(result)
                        except Exception as e:
                            self.add_output([f"{C.RED}Error: {e}{C.NC}"])
                    
                    input_buffer = ""
                    self.draw_screen("")
                    last_draw = time.time()
                    
                elif key_type == 'tab':
                    completions = self.handler.get_completions(input_buffer)
                    if completions:
                        input_buffer = completions[0]
                    self.draw_screen(input_buffer)
                    last_draw = time.time()
                    
                elif key_type == 'up':
                    hist = self.handler.history_up()
                    if hist:
                        input_buffer = hist
                    self.draw_screen(input_buffer)
                    
                elif key_type == 'down':
                    hist = self.handler.history_down()
                    input_buffer = hist
                    self.draw_screen(input_buffer)
                    
                elif key_type == 'backspace':
                    input_buffer = buf
                    self.draw_screen(input_buffer)
                    
                elif key_type == 'char':
                    input_buffer = buf
                    self.draw_screen(input_buffer)
                
                elif key_type == 'escape':
                    self.draw_screen(input_buffer)
                
                elif key_type == 'timeout':
                    continue
        
        except KeyboardInterrupt:
            pass
        except EOFError:
            pass
        finally:
            print(SHOW_CURSOR, end='')
            time_running = False

# ─────────────────────────────────────────────────────────────
# Entry Point
# ─────────────────────────────────────────────────────────────
if __name__ == "__main__":
    try:
        app = LoopTUI()
        app.run()
    except KeyboardInterrupt:
        print(SHOW_CURSOR, end='')
